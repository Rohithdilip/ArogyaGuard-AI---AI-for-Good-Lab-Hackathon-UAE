# Copy to .env; do not commit the real key. OpenRouter billing/usage may apply.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_SECONDS=45
# Optional local SQLite database path:
# AROGYA_DB_PATH=data/knowledge.sqlite3
# Local hybrid retrieval (no paid embedding API; downloads model on first semantic build)
AROGYA_VECTOR_ENABLED=true
AROGYA_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# AROGYA_VECTOR_PATH=   # optional local Qdrant directory
AROGYA_OCR_ENABLED=true
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
